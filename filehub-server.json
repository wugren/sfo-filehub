{
  "server": {
    "server_addr": "0.0.0.0",
    "port": 8080,
    "allow_origins": ["*"],
    "allow_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allow_headers": ["*"],
    "expose_headers": [],
    "max_age": 3600,
    "support_credentials": false
  },
  "users": {
    "session_key": "replace-with-a-long-random-secret",
    "users": [
      { "username": "admin", "password": "change-me", "role": "owner" }
    ]
  },
  "files": {
    "data_dir": "./data/files",
    "max_archive_bytes": 104857600
  },
  "db_path": "./data/filehub.db"
}
